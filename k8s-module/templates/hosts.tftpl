---
control_plane_nodes:
  hosts:
%{ for i, cp_node_ip in control_plane_ips ~}
    ${control_plane_prefix}${i}:
      ansible_host: ${cp_node_ip}
      ansible_port: 22
      ansible_ssh_user: ${remote_user}
      ansible_ssh_private_key_file: ${ssh_key_path}
%{ endfor ~}
worker_nodes:
  hosts:
%{ for i, worker_ip in worker_nodes_ips ~}
    ${worker_prefix}${i}:
      ansible_host: ${worker_ip}
      ansible_port: 22
      ansible_ssh_user: ${remote_user}
      ansible_ssh_private_key_file: ${ssh_key_path}
%{ endfor ~}