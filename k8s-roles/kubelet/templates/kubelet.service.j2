[Unit]
Description=kubelet: The Kubernetes Node Agent
Wants=network-online.target
After=network-online.target

[Service]
Environment="KUBELET_CONFIG_ARG=--config={{ kubelet_config_path }}"
Environment="KUBELET_KUBECONFIG_ARG=--kubeconfig={{ kubelet_kubeconfig_path }}"
Environment="KUBELET_HOSTNAME_ARG=--hostname-override={{ inventory_hostname }}"
ExecStart={{ kubelet_bin_dir }}/kubelet $KUBELET_CONFIG_ARG $KUBELET_KUBECONFIG_ARG $KUBELET_HOSTNAME_ARG
Restart=always
StartLimitInterval=0
RestartSec=10

[Install]
WantedBy=multi-user.target