apiVersion: v1
kind: Pod
metadata:
  name: kube-apiserver
  namespace: kube-system
spec:
  containers:
    - name: kube-apiserver
      image: registry.k8s.io/kube-apiserver:v1.36.0
      command:
        - kube-apiserver
        - --advertise-address={{ ansible_default_ipv4.address }}
        - --authorization-mode=Node,RBAC
        - --allow-privileged=true
        - --kubelet-preferred-address-types=InternalIP
        - --client-ca-file=/etc/kubernetes/pki/ca.crt
        - --etcd-cafile=/etc/kubernetes/pki/etcd/ca.crt
        - --etcd-certfile=/etc/kubernetes/pki/etcd/apiserver-etcd-client.crt
        - --etcd-keyfile=/etc/kubernetes/pki/etcd/apiserver-etcd-client.key
        - --etcd-servers={% for host in groups['control_plane_nodes'] %}https://{{ host }}.{{ cluster_domain }}:2379{% if not loop.last %},{% endif %}{% endfor %}

        - --kubelet-client-certificate=/etc/kubernetes/pki/apiserver-kubelet-client.crt
        - --kubelet-client-key=/etc/kubernetes/pki/apiserver-kubelet-client.key
        - --tls-cert-file=/etc/kubernetes/pki/apiserver.crt
        - --tls-private-key-file=/etc/kubernetes/pki/apiserver.key
        - --service-cluster-ip-range=172.20.0.0/16
        - --service-account-issuer=https://kubernetes.default.svc.cluster.local
        - --service-account-key-file=/etc/kubernetes/pki/sa.pub
        - --service-account-signing-key-file=/etc/kubernetes/pki/sa.key
      livenessProbe:
        httpGet:
          path: /livez
          host: localhost
          port: 6443
          scheme: HTTPS
        initialDelaySeconds: 10
        periodSeconds: 10
        timeoutSeconds: 15
      readinessProbe:
        httpGet:
          path: /readyz
          host: localhost
          port: 6443
          scheme: HTTPS
        periodSeconds: 5
        timeoutSeconds: 15
      startupProbe:
        httpGet:
          host: localhost
          path: /livez
          port: 6443
          scheme: HTTPS
        initialDelaySeconds: 10
        periodSeconds: 10
        timeoutSeconds: 15
      resources:
        requests:
          cpu: 250m
      volumeMounts:
        - name: server-pki-vol
          mountPath: /etc/kubernetes/pki
  hostNetwork: true
  priorityClassName: system-node-critical
  volumes:
    - name: server-pki-vol
      hostPath:
        path: /etc/kubernetes/pki
        type: DirectoryOrCreate
  